# --- Running on your own computer (the default) ---
# Path of the SQLite database holding your real data (relative to the project root).
DATABASE_URL="file:./data/finance.db"

# --- Hosting it (Vercel + Neon): set these in Vercel -> Settings -> Environment Variables (Production) ---
# DATABASE_URL     your Neon connection string, e.g. postgres://user:pass@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# APP_PASSWORD     the password that opens the app (4+ characters; a 4-digit code works, longer is safer). Required whenever the app is hosted.
# AUTH_SECRET      a long random string, 16+ characters (e.g. `openssl rand -hex 32`) that signs the login cookie. Required together with APP_PASSWORD.
