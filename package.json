{
  "name": "finance-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:demo": "tsx scripts/demo.ts",
    "setup": "prisma generate && tsx scripts/migrate.ts",
    "build:vercel": "tsx scripts/migrate-pg.ts && next build",
    "db:deploy:pg": "tsx scripts/migrate-pg.ts",
    "db:migrate:pg": "node scripts/pg-migration.mjs",
    "db:import": "tsx scripts/import-backup.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.6",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "22.x"
  }
}
