// Personal finance ledger.
//
// Conventions
//  - Money is stored as exact decimal STRINGS (e.g. "1234.56"). SQLite has no true decimal type and
//    floats are never acceptable for money; all arithmetic happens in src/lib/finance with decimal.js.
//  - Exchange rates are decimal strings too (>= 6 decimal places of precision are kept).
//  - Transaction dates are calendar dates ("YYYY-MM-DD") in the user's timezone (Asia/Baku by default),
//    so a transaction never drifts to another day because of a UTC conversion.
//  - Enum-like columns are plain strings validated by Zod (see src/lib/finance/schemas.ts).
//  - Balances are never stored: they are derived from the transactions, so edits, deletions and
//    back-dated entries can never leave a stale balance behind.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma-pg"
}

datasource db {
  provider = "postgresql"
}

/// Single-row table (id = 1) with global preferences.
model Settings {
  id                  Int       @id @default(1)
  baseCurrency        String    @default("AZN")
  timezone            String    @default("Asia/Baku")
  locale              String    @default("en-US")
  /// MONTH = calendar month, CYCLE = salary payment cycle starting on `cycleStartDay`
  reportingMode       String    @default("MONTH")
  cycleStartDay       Int       @default(1)
  weekStartsOn        Int       @default(1)
  /// SAVE_ALL | PERCENT_TARGET | FIXED_MONTHLY | BUDGET_50_30_20 | EMERGENCY_FIRST
  activeStrategy      String    @default("SAVE_ALL")
  /// JSON object keyed by strategy id; switching strategy never loses another strategy's parameters.
  strategyConfig      String    @default("{}")
  deductUpcomingBills Boolean   @default(false)
  upcomingBillsDays   Int       @default(30)
  /// Optional monthly variable-spending assumption (base currency) used by the forecast.
  forecastSpending    String?
  onboardedAt         DateTime?
  updatedAt           DateTime  @updatedAt
}

/// A place where money physically is: debit card, cash, savings account...
model Account {
  id              String   @id @default(cuid())
  name            String
  /// CARD | CASH | SAVINGS | OTHER
  type            String
  currency        String
  /// Free-text nickname only. No card numbers or credentials are ever stored.
  nickname        String?
  color           String?
  archived        Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions  Transaction[]      @relation("TxAccount")
  incoming      Transaction[]      @relation("TxToAccount")
  incomeSources IncomeSource[]
  rates         ExchangeRate[]
  recurring     RecurringPayment[]
}

/// Where money came from: a salary, a bonus, side income... plus one system source
/// ("Existing funds") that carries opening balances / previous savings.
model IncomeSource {
  id                   String   @id @default(cuid())
  name                 String
  /// SALARY | BONUS | SIDE | OTHER | OPENING
  kind                 String   @default("SALARY")
  isSystem             Boolean  @default(false)
  currency             String
  expectedAmount       String?
  /// MONTHLY | SEMI_MONTHLY | BIWEEKLY | WEEKLY | ONCE | NONE
  scheduleType         String   @default("NONE")
  /// JSON number[]: days of month (MONTHLY / SEMI_MONTHLY) or weekday 0-6 (WEEKLY)
  scheduleDays         String   @default("[]")
  /// Anchor / first date (YYYY-MM-DD). Required for BIWEEKLY and ONCE.
  scheduleAnchor       String?
  scheduleEnd          String?
  destinationAccountId String?
  color                String?
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  destinationAccount Account?                @relation(fields: [destinationAccountId], references: [id], onDelete: SetNull)
  payments           Transaction[]
  allocations        TransactionAllocation[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  /// Key into the curated icon set (src/components/icons.ts)
  icon      String   @default("circle")
  color     String   @default("#A5A8AE")
  /// 50/30/20 grouping: NEEDS | WANTS | OTHER
  bucket    String   @default("WANTS")
  archived  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringPayment[]
}

/// One financial event. The ledger entries (postings) are derived from these rows.
///
/// type:
///   INCOME      money received into `accountId` from `incomeSourceId`
///   EXPENSE     money spent from `accountId`
///   REFUND      money returned into `accountId`, reverses an expense (never counted as income)
///   TRANSFER    same-currency move between two of my accounts (not an expense)
///   EXCHANGE    cross-currency conversion between two of my accounts (not an expense)
///   OPENING     money I already owned when I started using the app (not income)
///   ADJUSTMENT  reconciliation correction to an account balance (not income / expense)
model Transaction {
  id             String   @id @default(cuid())
  type           String
  /// YYYY-MM-DD in the user's timezone
  date           String
  /// HH:mm, optional
  time           String?
  accountId      String
  toAccountId    String?
  /// Principal amount, in `currency`
  amount         String
  currency       String
  /// EXPENSE / REFUND only: what actually left / entered the account when `currency` differs from the
  /// account currency (e.g. a USD-denominated bill paid by an AZN card). Null means same as `amount`.
  accountAmount  String?
  /// TRANSFER / EXCHANGE: amount credited to `toAccountId` (in that account's currency)
  toAmount       String?
  feeFixed       String?
  feePercent     String?
  /// Total separately-charged fee, in the origin account's currency
  feeAmount      String?
  /// JSON map { CCY: "rate to base currency" } frozen when the transaction was recorded, so later
  /// changes to the default rates never rewrite history.
  fx             String?
  /// EXCHANGE: effective rate = toAmount / amount (incl. the bank's embedded spread)
  exchangeRate   String?
  description    String   @default("")
  notes          String?
  /// JSON string[]
  tags           String   @default("[]")
  categoryId     String?
  /// INCOME only
  incomeSourceId String?
  /// INCOME only: the scheduled payment date this receipt settles (null = unscheduled / bonus)
  expectedDate   String?
  /// INCOME only: expected amount of that occurrence (snapshot, in the source currency)
  expectedAmount String?
  refundOfId     String?
  recurringId    String?
  /// The scheduled due date of a recurring payment this expense settles
  dueDate        String?
  /// OPENING: EXISTING_FUNDS | PREVIOUS_SAVINGS. ADJUSTMENT: free reason key.
  subtype        String?
  /// AUTO = attribution follows the money in the paying account; MANUAL = use `allocations`
  allocationMode String   @default("AUTO")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account      Account           @relation("TxAccount", fields: [accountId], references: [id])
  toAccount    Account?          @relation("TxToAccount", fields: [toAccountId], references: [id])
  category     Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  incomeSource IncomeSource?     @relation(fields: [incomeSourceId], references: [id])
  refundOf     Transaction?      @relation("Refunds", fields: [refundOfId], references: [id], onDelete: SetNull)
  refunds      Transaction[]     @relation("Refunds")
  recurring    RecurringPayment? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  allocations  TransactionAllocation[]

  @@index([date])
  @@index([accountId, date])
  @@index([type, date])
  @@index([categoryId])
  @@index([incomeSourceId])
}

/// Which income source(s) funded a transaction (MANUAL attribution / splits).
/// Amounts are in the paying account's currency and always sum exactly to the account debit.
model TransactionAllocation {
  id            String @id @default(cuid())
  transactionId String
  sourceId      String
  amount        String

  transaction Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  source      IncomeSource @relation(fields: [sourceId], references: [id])

  @@unique([transactionId, sourceId])
}

/// Default / preferred conversion rates, effective-dated so history is preserved.
/// accountId = null  -> global fallback rate; otherwise that card's own preferred rate.
model ExchangeRate {
  id            String   @id @default(cuid())
  fromCurrency  String
  toCurrency    String
  /// 'toCurrency units per 1 fromCurrency', decimal string (>= 6 dp supported)
  rate          String
  /// YYYY-MM-DD from which the rate applies
  effectiveFrom String
  accountId     String?
  note          String?
  createdAt     DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([fromCurrency, toCurrency, effectiveFrom])
}

model Goal {
  id           String   @id @default(cuid())
  name         String
  /// RESERVE = money set aside from savings | TOTAL = milestone on total savings | EMERGENCY
  kind         String   @default("RESERVE")
  targetAmount String
  currency     String
  targetDate   String?
  /// 1 = high, 2 = medium, 3 = low
  priority     Int      @default(2)
  isPrimary    Boolean  @default(false)
  icon         String   @default("target")
  color        String?
  note         String?
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())

  allocations GoalAllocation[]
}

/// Reserving (positive) or releasing (negative) existing money for a goal. Never moves money.
model GoalAllocation {
  id        String   @id @default(cuid())
  goalId    String
  date      String
  /// signed, in the goal's currency
  amount    String
  note      String?
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

/// Optional monthly spending limit (base currency). categoryId = null -> overall limit.
model Budget {
  id         String   @id @default(cuid())
  categoryId String?  @unique
  amount     String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

/// Template for a recurring bill / subscription. Nothing is deducted until an occurrence is
/// recorded as paid (which creates a normal EXPENSE transaction).
model RecurringPayment {
  id           String   @id @default(cuid())
  description  String
  amount       String
  currency     String
  accountId    String
  categoryId   String?
  /// WEEKLY | MONTHLY | YEARLY
  frequency    String   @default("MONTHLY")
  interval     Int      @default(1)
  dayOfMonth   Int?
  startDate    String
  endDate      String?
  isActive     Boolean  @default(true)
  /// JSON string[] of due dates the user chose to skip
  skippedDates String   @default("[]")
  /// JSON { sourceId: percent } or null for AUTO attribution
  sourceShares String?
  tags         String   @default("[]")
  notes        String?
  createdAt    DateTime @default(now())

  account  Account       @relation(fields: [accountId], references: [id])
  category Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments Transaction[]
}

/// Append-only change history: every create / edit / delete keeps before & after snapshots.
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  entity   String
  entityId String
  /// CREATE | UPDATE | DELETE | RESTORE | IMPORT
  action   String
  summary  String
  before   String?
  after    String?

  @@index([at])
  @@index([entity, entityId])
}

/// One row (id = "login") that counts sign-in tries, so a short password such as a 4-digit code
/// can't be guessed in bulk. Not part of your data: backups and restores never touch it.
model LoginGuard {
  id          String    @id
  /// Fingerprint of the current password + AUTH_SECRET: changing either one starts the count afresh.
  keyId       String
  /// Tries since the last correct sign-in. Each try is counted before the password is looked at.
  attempts    Int       @default(0)
  lastTryAt   DateTime?
  /// While this is in the future, no password is checked at all.
  lockedUntil DateTime?
  /// Bumped on every change, so two requests can never both claim the same try.
  version     Int       @default(0)
}
